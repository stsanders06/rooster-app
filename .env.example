# Kopieer naar .env en pas aan wat je wilt. Daarna: docker compose up -d

# De poort op de Pi. De facturen-app zit al op 8099.
POORT=8100

# Alleen op één adres van de Pi luisteren (bijvoorbeeld 127.0.0.1 achter een
# reverse proxy). Leeg = alle netwerken. ufw houdt een Docker-poort niet tegen.
LUISTER_ADRES=

TZ=Europe/Amsterdam
LOG_LEVEL=info

# Eigenaar van de map data: wat id -u en id -g zeggen. 0 (root) weigert de app.
PUID=1000
PGID=1000

# 1 als je de app alleen via https opent. Over gewoon http:// moet dit 0
# blijven, anders kom je niet meer binnen.
SESSION_COOKIE_SECURE=0
